# Copy to frontend/.env.local (git-ignored) and fill in. Never commit real keys.
# HERE (optional online extras: night map tiles, live traffic, transit cross-check). Without it the app uses
# OpenStreetMap tiles and simulated traffic. Restrict the key in the HERE console: it is bundled into the APK.
VITE_HERE_API_KEY=
# Force the basemap: here | osm (default: here when a key exists)
# VITE_MAP_PROVIDER=osm
# Dispatch server for help requests (phone and laptop on the same Wi-Fi)
# VITE_DISPATCH_URL=http://192.168.1.10:8787

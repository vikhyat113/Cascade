{
  "name": "nightway-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "vitest run && tsc -b && vite build",
    "preview": "vite preview",
    "data": "node ../scripts/py.mjs ../tools/build_data.py",
    "apk": "bash ../scripts/build-apk.sh",
    "apk:install": "bash ../scripts/build-apk.sh --install",
    "live": "cap run android -l --external",
    "e2e": "node e2e/sos.e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.1",
    "playwright-core": "^1.49.1",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
